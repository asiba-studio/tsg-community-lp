NEXT_PUBLIC_ADOBE_FONTS_KIT_ID=

MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# MicroCMS Webhook がキャッシュをパージするための合言葉
# MicroCMS管理画面 > API設定 > Webhook > カスタムヘッダー x-microcms-secret に設定
MICROCMS_REVALIDATE_SECRET=

# MicroCMS プレビュー用シークレット
# /api/draft?secret=xxx の xxx に設定する任意の文字列
MICROCMS_PREVIEW_SECRET=