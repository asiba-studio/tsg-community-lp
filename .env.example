MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# MicroCMS Webhook の署名検証用シークレット
# MicroCMS管理画面 > API設定 > Webhook > Secret に同じ値を設定（x-microcms-signature の検証に使用）
MICROCMS_WEBHOOK_SECRET=

# MicroCMS 画面プレビュー用シークレット
# /api/draft?secret=xxx の xxx に設定する任意の文字列（draftKey方式。draftMode cookieは使わない）
MICROCMS_DRAFT_SECRET=
